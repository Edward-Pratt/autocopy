#!/bin/sh
# Mirror the primary selection (highlighted text) into the clipboard.
# Without arguments, watch the primary selection; wl-paste re-runs this
# script with --sync and the new selection on stdin for every change.
[ "$1" = --sync ] || exec wl-paste --primary --watch "$0" --sync

# Clicking elsewhere clears the primary selection ("nil"/"clear"), and password
# fields mark it "sensitive". Copy only real data so the clipboard survives.
[ "$CLIPBOARD_STATE" = data ] || exit 0

# The trailing "x" keeps trailing newlines that $(...) would strip.
data=$(cat; printf x)
data=${data%x}
[ -n "$data" ] || exit 0
printf %s "$data" | wl-copy
